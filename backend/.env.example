# Application Settings
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-me
PORT=5000

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Pakistan12
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flash_sale_db
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:posthres@localhost:5432/flash_sale_db

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration (RabbitMQ 3)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & Tokens
JWT_SECRET_KEY=super-secret-key-change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
