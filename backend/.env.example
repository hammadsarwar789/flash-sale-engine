# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# Copy this file to .env in production/local setup and fill in secure values.
# NEVER commit real passwords, secrets, or API keys to version control.
# ==============================================================================

# Application Settings
FLASK_APP=wsgi.py
FLASK_ENV=development
PORT=5000

# Security & Secret Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
# REQUIRED in production (Application will abort if default key is detected)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=flash_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flash_sale_db
# Full connection URI: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://flash_user:replace-with-strong-db-password@localhost:5432/flash_sale_db

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration (RabbitMQ 3)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Celery Task Queue Configuration
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Initial Admin Seed Credentials
ADMIN_INITIAL_EMAIL=admin@flashsale.com
ADMIN_INITIAL_PASSWORD=replace-with-initial-secure-admin-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Payment Gateway (Optional - leave empty for mock sandbox mode)
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key_51ABCxyz

# Shopify Integration (Optional)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_placeholder_access_token
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=shpss_placeholder_webhook_secret
SHOPIFY_LOCATION_ID=loc_default_01

# Monitoring & Error Reporting (Optional)
SENTRY_DSN=
