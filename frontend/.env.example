# Frontend Environment Configuration Template
# Copy this file to .env or .env.local for local development

# Public API Base URL (Used for production builds or custom backend hosts)
# Defaults to empty string or /api/v1 in local Vite proxy development
VITE_API_BASE_URL=/api/v1

# Public WebSocket Endpoint (if applicable)
VITE_WS_URL=ws://localhost:5000/ws

# Public Stripe Publishable Key (Client-Safe public key - NOT the Secret Key!)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_51ABCxyz
